CONTEXT_COMPACTION_TTL_SECONDS = 5 * 60.0
# Treat each newly rendered 429 as the same ordinary recovery interval. The
# event de-duplication and live-terminal checks still prevent replaying one
# stale line, while a new server response can be retried after two seconds.
