)
CYBER_RISK_FLAGGED_RE = re.compile(
    r"^■ This content was flagged for possible cybersecurity risk\. "
    r"If this seems wrong, try rephrasing your request\. To get authorized "
    r"for security work, join the Trusted Access for Cyber program:[ \t]*\n"
    r"https://chatgpt\.com/cyber[ \t]*$",
    re.MULTILINE,
)
WORKED_RE = re.compile(
    r"^─ Worked for (?:\d+h )?\d+m \d+s +─+[ \t]*$",
    re.MULTILINE,
)
TOP_LEVEL_BULLET_RE = re.compile(r"^• (?P<body>.+)$")
FINAL_RESPONSE_SEPARATOR_RE = re.compile(r"^[─━═]{20,}[ \t]*$")
CODEX_ACTIVITY_BULLET_RE = re.compile(
    r"^(?:"
    r"Ran|Explored|Edited|Waited for|Added|Updated Plan|"
    r"Interacted with|Started|Called|Waiting for agents|"
    r"Finished waiting|Context compacted|Interrupted"
    r")(?:\s|$)"
)
WORKED_INTERRUPTED = "worked_interrupted"
WORKED_COMPLETE = "worked_complete"
WORKED_UNKNOWN = "worked_unknown"
CONTEXT_TOO_LARGE = "context_too_large"
CONTEXT_COMPACTED = "context_compacted"
RATE_LIMIT = "rate_limit"
NON_ACTIONABLE_EVENTS = frozenset(
    {WORKED_COMPLETE, WORKED_UNKNOWN, CONTEXT_COMPACTED}
)
