        ),
    }
)

# Requiring Codex's exact event glyph and structure in column zero avoids
# matching quoted text in user prompts, assistant messages, or shell output.
ERROR_RE = re.compile(
    r"^■ (?:Error running remote compact task: )?"
    r"An error occurred while processing\b[^\n]*$",
    re.MULTILINE,
)
CAPACITY_RE = re.compile(
    r"^⚠ Selected model is at capacity\. Please try a different model\.[ \t]*$",
    re.MULTILINE,
)
STREAMING_ERROR_RE = re.compile(
    r"^■ internal streaming error, please retry(?:[ \t]+---)?[ \t]*$",
    re.MULTILINE,
)
STREAM_DISCONNECTED_RE = re.compile(
    r"^■ stream disconnected before completion: stream closed before "
    r"response\.completed(?:[ \t]+---)?[ \t]*$",
    re.MULTILINE,
)
SERVER_OVERLOADED_RE = re.compile(
    r"^■ (?:Error running remote compact task: )?"
    r"Our servers are currently overloaded\. Please try again later\."
    r"(?:[ \t]+---)?[ \t]*$",
    re.MULTILINE,
)
RATE_LIMIT_RE = re.compile(
    r"^■ exceeded retry limit, last status: 429 Too Many Requests"
    r"(?:,[ \t]+request id:[ \t]+"
    r"(?:[0-9A-Fa-f]{8}|"
    r"[0-9A-Fa-f]{8}(?:-[0-9A-Fa-f]{4}){3}-[0-9A-Fa-f]{12})"
    r")?"
    r"(?:[ \t]+---)?[ \t]*$",
    re.MULTILINE,
)
GOAL_DURATION_RE = r"(?:\d+s|\d+m|\d+h(?: \d+m)?|\d+d \d+h \d+m)"
GOAL_COMPACT_TOKENS_RE = r"\d+(?:\.\d+)?[KMBT]?"
GOAL_STATUS_RE = re.compile(
    r"^• Goal (?P<status>active|paused|stalled|blocked|usage limited|"
    r"limited by budget|budget limited|complete|achieved|unmet|abandoned) "
    r"Objective: "
    r"\S(?:.*?\S)?"
    rf"(?: Time: {GOAL_DURATION_RE}\.)?"
    rf"(?: Tokens: {GOAL_COMPACT_TOKENS_RE}/{GOAL_COMPACT_TOKENS_RE}\.)?"
    r"[ \t]*$",
    re.MULTILINE,
)
GOAL_RESUMABLE_STATUSES = frozenset(
    {"active", "paused", "stalled", "blocked", "usage limited"}
)
EMPTY_COMPOSER_RE = re.compile(
    r"^(?:\[[A-Z][A-Z -]*\][ \t]+)?(?P<prompt>[›»])"
    r"(?:[ \t]+\S(?:.*\S)?)?[ \t]*$",
    re.MULTILINE,
)
GOAL_FOOTER_ACTIVE_USAGE_RE = (
    rf"(?:{GOAL_COMPACT_TOKENS_RE} / {GOAL_COMPACT_TOKENS_RE}|"
    rf"{GOAL_DURATION_RE})"
)
GOAL_FOOTER_UNMET_USAGE_RE = (
    rf"{GOAL_COMPACT_TOKENS_RE} / {GOAL_COMPACT_TOKENS_RE} tokens"
)
GOAL_FOOTER_ACHIEVED_USAGE_RE = (
    rf"(?:{GOAL_COMPACT_TOKENS_RE} tokens|{GOAL_DURATION_RE})"
)
GOAL_FOOTER_STATUS_RE = re.compile(
    r"^ {2,}(?:\S(?:[^\n]*?\S)?[ \t]+)?(?P<status>"
    rf"Pursuing goal(?: \({GOAL_FOOTER_ACTIVE_USAGE_RE}\))?|"
    r"Goal paused \(/goal resume\)|"
    r"Goal stalled \(/goal resume\)|"
    r"Goal hit usage limits \(/goal resume\)|"
    rf"Goal unmet \({GOAL_FOOTER_UNMET_USAGE_RE}\)|"
    r"Goal abandoned|"
    rf"Goal achieved(?: \({GOAL_FOOTER_ACHIEVED_USAGE_RE}\))?"
    r")(?: · IDE context)?[ \t]*$",
    re.MULTILINE,
)
ANSI_CSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
CONTEXT_TOO_LARGE_HEADER_RE = re.compile(
    r"^■ unexpected status 413 Payload Too Large:[ \t]*.*$",
    re.MULTILINE,
)
CONTEXT_WINDOW_EXHAUSTED_RE = re.compile(
    r"^■ Codex ran out of room in the model's context window\. "
    r"Start a new thread or clear earlier history before retrying\."
    r"(?:[ \t]+---)?[ \t]*$",
    re.MULTILINE,
)
CONTEXT_COMPACTED_RE = re.compile(
    r"^• Context compacted(?:[ \t].*)?[ \t]*$",
    re.MULTILINE,
)
CYBER_CONTENT_BLOCKED_RE = re.compile(
    r"^ⓘ This content can't be shown[ \t]*\n"
    r"  We take extra caution with cybersecurity requests\. If you’re a "
    r"security professional, you may be able to apply for Trusted Access\."
    r"[ \t]*\n"
    r"  Trusted Access: "
    r"https://openai\.com/form/enterprise-trusted-access-for-cyber/"
    r"[ \t]*\n"
    r"  Learn more: https://help\.openai\.com/en/articles/20001326[ \t]*$",
