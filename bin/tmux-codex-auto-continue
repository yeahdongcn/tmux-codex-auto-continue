    assert not styled_composer_is_empty(
        "\x1b[1m›\x1b[0m \x1b[2;22muser-text",
        0,
    )
    assert styled_composer_is_empty(
        "\x1b[1m›\x1b[0m \x1b[22;2mplaceholder",
        0,
    )

    retry_sample = "\n".join(
        [
