        "/tmp/node_modules/@openai/codex/node_modules/@openai/"
        "codex-linux-arm64/vendor/aarch64/bin/codex"
    )
    assert not tmux_mode_active("0")
    assert tmux_mode_active("1")
    assert tmux_mode_active("2")
    assert tmux_mode_active("")
    assert tmux_mode_active("unexpected")
    assert composer_is_empty(EMPTY_COMPOSER_CURSOR_X)
    assert not composer_is_empty(EMPTY_COMPOSER_CURSOR_X + 1)
    assert not composer_is_empty(None)
    styled_dynamic_hint = (
        "\x1b[1m\x1b[38;5;5m»\x1b[0m\x1b[39m\x1b[49m "
        "\x1b[2mSummarize recent commits\x1b[0m\x1b[39m\x1b[49m\n"
        "  Goal stalled (/goal resume)"
    )
    assert styled_composer_is_empty(styled_dynamic_hint, 0)
    assert styled_composer_is_empty("\x1b[1m›\x1b[0m", 0)
    assert styled_composer_is_empty(
        "\x1b[1m»\x1b[0m \x1b[2mUse › to continue\x1b[0m",
        0,
    )
    assert not styled_composer_is_empty("» Summarize recent commits", 0)
    assert not styled_composer_is_empty(
        "\x1b[1m»\x1b[0m user › \x1b[2mhint\x1b[0m",
        0,
    )
    assert not styled_composer_is_empty(
        "\x1b[1m›\x1b[0m \x1b[2mplaceholder\x1b[22m user-text",
        0,
    )
    assert not styled_composer_is_empty(
        "\x1b[1m›\x1b[0m\n  multiline user text",
        1,
