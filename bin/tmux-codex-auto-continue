    assert safety_menu_selection(safety_popup) == "retry"
    selected_wait = safety_popup.replace(
        "› 1. Retry with a faster model\n  2. Keep waiting",
        "  1. Retry with a faster model\n› 2. Keep waiting",
    )
    assert safety_menu_selection(selected_wait) == "wait"
    selected_learn = selected_wait.replace(
        "› 2. Keep waiting\n  3. Learn more",
        "  2. Keep waiting\n› 3. Learn more",
    )
    assert safety_menu_selection(selected_learn) == "learn"
    no_retry_popup = "\n".join(
        [
            "  Additional safety checks",
            "  This request requires additional safety checks, which can take",
            "  extra time.",
            "",
            "› 1. Keep waiting",
            "  2. Learn more",
            "",
            "  Press enter to confirm or esc to go back",
        ]
    )
    assert safety_menu_selection(no_retry_popup) == "wait"
    assert safety_menu_selection(safety_popup.replace("  Press enter", "  Hit enter")) is None
    assert safety_menu_selection(safety_popup + "\n  quoted after popup") is None
    quoted_popup = safety_popup.replace(
        "  Additional safety checks",
        "› Additional safety checks",
    )
    assert safety_menu_selection(quoted_popup) is None

    first_error = "error:4031e3df-b388-458c-aa39-38f0fffa8295"
    second_error = "error:5031e3df-b388-458c-aa39-38f0fffa8295"
    assert appended_events([first_error], [first_error]) == []
    assert appended_events(
        [first_error],
        [first_error, second_error],
    ) == [second_error]

    rate_state = PaneState("test-process", [], (80, 24))
    assert appended_events([RATE_LIMIT], [RATE_LIMIT]) == []
    assert appended_events(
        [RATE_LIMIT],
        [RATE_LIMIT, RATE_LIMIT],
    ) == [RATE_LIMIT]
    latched_rate_state = PaneState(
        "test-process",
        [RATE_LIMIT],
        (80, 24),
        rate_limit_terminal_latched=True,
    )
    latched_events: list[str] = []
    reconcile_rate_limit_terminal(latched_rate_state, latched_events, True)
    assert latched_events == []
    reconcile_rate_limit_terminal(latched_rate_state, latched_events, False)
    assert not latched_rate_state.rate_limit_terminal_latched
    reconcile_rate_limit_terminal(latched_rate_state, latched_events, True)
    assert latched_events == [RATE_LIMIT]
    reconcile_rate_limit_terminal(latched_rate_state, latched_events, True)
    assert latched_events == [RATE_LIMIT]
    progressive_rate_state = PaneState("test-process", [], (80, 24))
    progressive_events = [RATE_LIMIT]
    reconcile_rate_limit_terminal(
        progressive_rate_state,
        progressive_events,
        False,
    )
    assert progressive_rate_state.rate_limit_terminal_latched
    next_progressive_events: list[str] = []
    reconcile_rate_limit_terminal(
        progressive_rate_state,
        next_progressive_events,
        True,
    )
    assert next_progressive_events == []
    assert observe_rate_limit_events(rate_state, [RATE_LIMIT], 100.0) == 2.0
    assert rate_state.rate_limit_retry_after == 102.0
    assert observe_rate_limit_events(rate_state, [RATE_LIMIT], 103.0) == 2.0
    assert rate_state.rate_limit_retry_after == 105.0
    observe_rate_limit_events(rate_state, ["server_overloaded"], 162.0)
    assert rate_state.rate_limit_attempts == 0
    assert rate_state.rate_limit_retry_after == 0.0
    assert observe_rate_limit_events(rate_state, [RATE_LIMIT], 2000.0) == 2.0
    rate_state.deferred_events[RATE_LIMIT] = 2000.0
    assert rate_state.rate_limit_retry_after == 2002.0
    expire_deferred_events(rate_state, 2029.0, "%0", "test")
    assert RATE_LIMIT in rate_state.deferred_events
    expire_deferred_events(rate_state, 2031.0, "%0", "test")
    assert RATE_LIMIT not in rate_state.deferred_events

    repeated_rate_state = PaneState("test-process", [], (80, 24))
    repeated_rate_state.rate_limit_attempts = 1
    assert (
        observe_rate_limit_events(
            repeated_rate_state,
            [RATE_LIMIT],
            3000.0,
        )
        == 2.0
    )
    repeated_rate_state.deferred_events[RATE_LIMIT] = 3000.0
    expire_deferred_events(repeated_rate_state, 3029.0, "%0", "test")
    assert RATE_LIMIT in repeated_rate_state.deferred_events
    expire_deferred_events(repeated_rate_state, 3031.0, "%0", "test")
    assert RATE_LIMIT not in repeated_rate_state.deferred_events

    # A real compaction can take longer than one minute. Keep the watcher-owned
    # phase alive for the observed 67-second case while retaining a finite
    # five-minute boundary for a compaction that never completes.
    delayed_compaction = PaneState(
        "test-process",
        [],
        (80, 24),
        awaiting_context_compacted=True,
        context_compaction_started=100.0,
    )
    assert CONTEXT_COMPACTION_TTL_SECONDS == 300.0
    assert not expire_compaction_wait(
        delayed_compaction,
        167.024,
        "%0",
        "test",
    )
    assert delayed_compaction.awaiting_context_compacted
    print("self-test: PASS")
    return 0


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--version", action="version", version=VERSION)
    parser.add_argument("--socket", help="tmux socket path")
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("--toggle", action="store_true")
    actions.add_argument("--restart", action="store_true")
    actions.add_argument("--status", action="store_true")
    actions.add_argument("--self-test", action="store_true")
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if not Path("/proc/self/stat").is_file():
        print("Linux with a mounted /proc filesystem is required", file=sys.stderr)
        return 1
    if args.self_test:
        return self_test()
    if not args.socket:
        print("--socket is required", file=sys.stderr)
        return 2
    if args.toggle:
        return toggle(args.socket)
    if args.restart:
        return restart_daemon(args.socket)
    if args.status:
        return show_status(args.socket)
    return run_daemon(args.socket)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        raise SystemExit(130)
