REQUEST_ID_RE = re.compile(
    r"\brequest ID\s+"
    r"(?P<request_id>[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-"
    r"[0-9a-f]{4}-[0-9a-f]{12})\b",
    re.IGNORECASE,
)


@dataclass
class PaneState:
    process_identity: str
    events: list[str]
    geometry: tuple[int, int]
    pending_events: set[str] = field(default_factory=set)
    pending_deferred_events: set[str] = field(default_factory=set)
    deferred_events: dict[str, float] = field(default_factory=dict)
    pending_reply: str | None = None
    awaiting_context_compacted: bool = False
    context_compacted_seen: bool = False
    context_retry_seen: bool = False
    context_compaction_started: float = 0.0
    rate_limit_attempts: int = 0
    rate_limit_last_seen: float = 0.0
    rate_limit_retry_after: float = 0.0
    rate_limit_terminal_latched: bool = False
    send_after: float = 0.0
    last_sent: float = 0.0
    last_menu_attempt: float = 0.0
    safety_menu_latched: bool = False
    safety_menu_absent_polls: int = 0


@dataclass(frozen=True)
class SubmitResult:
    reply: str | None = None
    preserve_pending: bool = False


def tmux_server_pid_from_environment(
    socket: str, tmux_environment: str
) -> int | None:
    """Return the tmux server PID encoded for this exact socket."""

    parts = tmux_environment.rsplit(",", 2)
    if len(parts) != 3 or not socket_paths_match(parts[0], socket):
        return None
    try:
        server_pid = int(parts[1])
    except ValueError:
        return None
    return server_pid if server_pid > 0 else None


@dataclass(frozen=True)
class TmuxCommand:
    executable: str
    environment: dict[str, str] | None = None


def socket_paths_match(left: str, right: str) -> bool:
    """Compare tmux socket identities without trusting textual aliases."""

    if left == right:
        return True
    try:
        return os.path.samefile(left, right)
    except OSError:
        return os.path.abspath(left) == os.path.abspath(right)


def proc_environment_value(pid: int, name: str) -> str | None:
    """Read one value from a same-owner Linux process environment."""

    try:
        entries = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
    except OSError:
        return None
    encoded_name = name.encode() + b"="
    for entry in entries:
        if entry.startswith(encoded_name):
            return entry[len(encoded_name) :].decode(errors="surrogateescape")
    return None


def absolute_executable(path: str) -> str | None:
    """Return a validated absolute executable path."""

    candidate = Path(path)
    if not candidate.is_absolute():
        return None
    try:
        if not candidate.is_file() or not os.access(candidate, os.X_OK):
            return None
    except OSError:
        return None
    return str(candidate)


def tmux_command(socket: str) -> TmuxCommand:
    """Resolve tmux even when the server's background PATH is minimal.

    A tmux server may have started before a user-local tmux directory was
    added to PATH. Commands launched with ``run-shell -b`` inherit that old
    environment. In that case, the trusted ``TMUX`` tuple identifies the
    exact server process, whose executable is available through ``/proc``.
    """

    override = absolute_executable(
        os.environ.get("TMUX_CODEX_AUTO_CONTINUE_TMUX", "")
    )
    if override is not None:
        return TmuxCommand(override)

    server_pid = tmux_server_pid_from_environment(
        socket, os.environ.get("TMUX", "")
    )
    if server_pid is not None:
        try:
            proc_dir = Path(f"/proc/{server_pid}")
            if proc_dir.stat().st_uid != os.getuid():
                raise PermissionError("tmux server belongs to another user")
            proc_executable = proc_dir / "exe"
            executable = proc_executable.resolve(strict=True)
            process_name = Path(f"/proc/{server_pid}/comm").read_text().strip()
        except (OSError, RuntimeError):
            pass
        else:
            if (
                (process_name == "tmux" or process_name.startswith("tmux: "))
                and executable.name == "tmux"
                and os.access(executable, os.X_OK)
            ):
                environment = os.environ.copy()
                for variable in ("LD_LIBRARY_PATH", "LD_PRELOAD"):
                    server_value = proc_environment_value(
                        server_pid, variable
                    )
                    if server_value is None:
                        environment.pop(variable, None)
                    else:
                        environment[variable] = server_value
                # Carry a stable absolute path into the child watcher. Keeping
                # `/proc/<pid>/exe` would make a long-lived watcher vulnerable
                # to PID reuse if this server exits and that PID is recycled.
                return TmuxCommand(str(executable), environment)

    discovered = shutil.which("tmux")
    if discovered is not None:
        return TmuxCommand(str(Path(discovered).resolve()))

    return TmuxCommand("tmux")


def run_tmux(socket: str, *args: str) -> subprocess.CompletedProcess[str]:
    resolved = tmux_command(socket)
    command = [resolved.executable, "-S", socket, *args]
    try:
        return subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            encoding="utf-8",
            errors="replace",
            check=False,
            env=resolved.environment,
        )
    except OSError as error:
        return subprocess.CompletedProcess(command, 127, "", str(error))


def log(message: str) -> None:
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    print(f"{timestamp} {message}", flush=True)


def classify_worked(text: str, worked_start: int) -> str:
    """Classify a Worked marker from the transcript immediately before it.

    Codex renders a full-width separator immediately before its final response
    block.  An interrupted turn instead ends on an internal activity block
    such as Ran, Explored, or Edited.  Unknown layouts fail closed.
    """

    lines = text[:worked_start].splitlines()
    bullet_index: int | None = None
    bullet_body = ""
    for index in range(len(lines) - 1, -1, -1):
        bullet = TOP_LEVEL_BULLET_RE.fullmatch(lines[index])
        if bullet is not None:
            bullet_index = index
            bullet_body = bullet.group("body")
            break

    if bullet_index is None:
        return WORKED_UNKNOWN

    previous_index = bullet_index - 1
    while previous_index >= 0 and not lines[previous_index].strip():
        previous_index -= 1
    # If capture-pane starts exactly on the activity header, its real
    # predecessor was truncated and cannot be checked. Also avoid associating
    # a very old activity block with a later, otherwise unknown Worked marker.
    if (
        previous_index < 0
        or len(lines) - bullet_index - 1 > MAX_ACTIVITY_TO_WORKED_LINES
    ):
        return WORKED_UNKNOWN
    if (
        FINAL_RESPONSE_SEPARATOR_RE.fullmatch(lines[previous_index]) is not None
    ):
        return WORKED_COMPLETE

    if CODEX_ACTIVITY_BULLET_RE.match(bullet_body) is not None:
        return WORKED_INTERRUPTED
    return WORKED_UNKNOWN


def context_too_large_records(text: str) -> list[tuple[int, int, str]]:
    """Return strict, bounded matches for context-compaction errors."""

    matches: list[tuple[int, int, str]] = []
    event_line_re = re.compile(r"^[■─›»•ⓘ⚠](?: |$)")

    for header in CONTEXT_TOO_LARGE_HEADER_RE.finditer(text):
        block = [header.group(0)]
        block_end = header.end()
        tail = text[header.end() :]
        if tail.startswith("\r\n"):
            tail = tail[2:]
            block_end += 2
        elif tail.startswith("\n"):
            tail = tail[1:]
            block_end += 1

        # capture-pane -J normally rejoins terminal wrapping. Keep a small
        # continuation allowance for proxies or renderers that emit logical
        # newlines inside the diagnostic itself.
        for raw_line in tail.splitlines(keepends=True)[:20]:
            line = raw_line.rstrip("\r\n")
            if not line.strip() or event_line_re.match(line):
                break
            block.append(line)
            block_end += len(raw_line)

        normalized = re.sub(r"\s+", " ", " ".join(block))
        if all(token in normalized for token in CONTEXT_TOO_LARGE_REQUIRED_TOKENS):
            matches.append((header.start(), block_end, CONTEXT_TOO_LARGE))

    # Codex can emit a native context-window diagnostic instead of the proxy's
    # detailed 413 block. Normalize it to the same two-stage compaction path.
    for match in CONTEXT_WINDOW_EXHAUSTED_RE.finditer(text):
        matches.append((match.start(), match.end(), CONTEXT_TOO_LARGE))

    return matches


def event_records(text: str) -> list[tuple[int, int, str]]:
    """Return ordered matches with source spans and normalized signatures."""

    matches: list[tuple[int, int, str]] = []

    for match in ERROR_RE.finditer(text):
        # Codex manually wraps this message on narrow panes, so search its
        # indented continuation block rather than only the first grid line.
        tail_lines = text[match.start() :].splitlines()
        block_lines = [tail_lines[0]]
        for line in tail_lines[1:16]:
            if not line.strip() or re.match(r"^[■─›»•] ", line):
                break
            block_lines.append(line)
        request_id = REQUEST_ID_RE.search("\n".join(block_lines))
        identity = (
            request_id.group("request_id").lower() if request_id else "unknown"
        )
        matches.append((match.start(), match.end(), f"error:{identity}"))

    for match in CAPACITY_RE.finditer(text):
        matches.append((match.start(), match.end(), "capacity"))

    for match in STREAMING_ERROR_RE.finditer(text):
        matches.append((match.start(), match.end(), "streaming_error"))

    for match in STREAM_DISCONNECTED_RE.finditer(text):
        matches.append((match.start(), match.end(), "stream_disconnected"))

    for match in SERVER_OVERLOADED_RE.finditer(text):
        matches.append((match.start(), match.end(), "server_overloaded"))

    for match in RATE_LIMIT_RE.finditer(text):
        matches.append((match.start(), match.end(), RATE_LIMIT))

    matches.extend(context_too_large_records(text))

    for match in CONTEXT_COMPACTED_RE.finditer(text):
        matches.append((match.start(), match.end(), CONTEXT_COMPACTED))

    for match in CYBER_CONTENT_BLOCKED_RE.finditer(text):
        matches.append((match.start(), match.end(), "cyber_content_blocked"))

    for match in CYBER_RISK_FLAGGED_RE.finditer(text):
        matches.append((match.start(), match.end(), "cyber_risk_flagged"))

    for match in WORKED_RE.finditer(text):
        matches.append(
            (
                match.start(),
                match.end(),
                classify_worked(text, match.start()),
            )
        )

    matches.sort(key=lambda item: item[0])
    return matches


def event_signatures(text: str) -> list[str]:
    """Return ordered, normalized matches from a captured pane."""

    return [signature for _, _, signature in event_records(text)]


def terminal_suffix_is_idle(suffix: str) -> bool:
    """Return whether no later submitted prompt or Codex output is visible."""

    if re.search(
        r"^[›»][ \t]+(?:Continue|/compact|/goal resume)[ \t]*$",
        suffix,
        re.MULTILINE,
    ):
        return False
    if re.search(r"^(?:•|■|ⓘ|└|│)[ \t]", suffix, re.MULTILINE):
        return False
    if len(re.findall(r"^[›»][ \t].*$", suffix, re.MULTILINE)) > 1:
        return False
    return True


def composer_has_visible_input(text: str) -> bool:
    """Return whether the bottom composer visibly contains user text."""

    lines = text.rstrip("\n").splitlines()
    return bool(lines and re.match(r"^[›»][ \t]+\S", lines[-1]))


def goal_footer_status_match(text: str, start: int = 0) -> re.Match[str] | None:
    """Return a strict current-footer Goal status after the composer row.

    Codex can render rotating suggestions such as ``Summarize recent commits``
    in an empty composer. Plain capture text cannot distinguish that hint from
    typed text, so submission still requires both independent cursor checks.
    """

    composers = list(EMPTY_COMPOSER_RE.finditer(text, start))
    if not composers:
        return None
    composer = composers[-1]
    footer_matches = list(GOAL_FOOTER_STATUS_RE.finditer(text, composer.end()))
    if not footer_matches:
        return None
    footer = footer_matches[-1]
    if text[composer.end() : footer.start()].strip():
        return None
    if text[footer.end() :].strip():
        return None
    return footer


def terminal_event_is_current_text(
    text: str,
    event: str,
    *,
    context_text: str | None = None,
) -> bool:
    """Reject a deferred event once a later turn is visible in the pane."""

    validation_text = (
        context_text
        if event == WORKED_INTERRUPTED and context_text is not None
        else text
    )
    records = event_records(validation_text)
    if event == CONTEXT_COMPACTED:
        if CONTEXT_COMPACTED_RE.search(text) is None:
            return False
        marker_indices = [
            index
            for index, record in enumerate(records)
            if record[2] == CONTEXT_COMPACTED
        ]
        if not marker_indices:
            return False
        marker_index = marker_indices[-1]
        allowed_trailers = {
            WORKED_INTERRUPTED,
            WORKED_COMPLETE,
            WORKED_UNKNOWN,
        }
        if any(
            record[2] not in allowed_trailers
            for record in records[marker_index + 1 :]
        ):
            return False
        marker_end = records[marker_index][1]
        return terminal_suffix_is_idle(validation_text[marker_end:])

    if not records or records[-1][2] != event:
        return False

    _, end, _ = records[-1]
    suffix = validation_text[end:]
    if event == RATE_LIMIT:
        # A failed goal turn renders this informational status cell after the
        # error. It does not represent a newer turn or user input. Keep the
        # exception strict and scoped only to the 429 recovery path.
        suffix = GOAL_STATUS_RE.sub("", suffix)
        footer = goal_footer_status_match(suffix)
        if footer is not None:
            suffix = suffix[: footer.start()] + suffix[footer.end() :]
    if not terminal_suffix_is_idle(suffix):
        return False

    if event == WORKED_INTERRUPTED:
        # The activity bullet can scroll above the viewport after large tool
        # output. Keep the original 400-line classification evidence, but
        # still require its Worked marker and idle composer to be visible now.
        visible_worked = list(WORKED_RE.finditer(text))
        if not visible_worked:
            return False
        if not terminal_suffix_is_idle(text[visible_worked[-1].end() :]):
            return False
    return True


def safety_menu_selection(text: str) -> str | None:
    """Return the selected row of a complete, currently rendered safety menu."""

    lines = text.splitlines()
    selection_names = {
        "Retry with a faster model": "retry",
        "Keep waiting": "wait",
        "Learn more": "learn",
    }

    for header_index, header in enumerate(lines):
        if SAFETY_MENU_HEADER_RE.fullmatch(header) is None:
            continue

        item_search_end = min(header_index + 14, len(lines))
        for first_item_index in range(header_index + 1, item_search_end):
            if SAFETY_MENU_ITEM_RE.fullmatch(lines[first_item_index]) is None:
                continue

            items: list[re.Match[str]] = []
            item_index = first_item_index
            while item_index < len(lines):
                item = SAFETY_MENU_ITEM_RE.fullmatch(lines[item_index])
                if item is None:
                    break
                items.append(item)
                item_index += 1

            labels = tuple(item.group("label") for item in items)
            if labels == SAFETY_MENU_WITH_RETRY:
                expected_message = SAFETY_MESSAGE_WITH_RETRY
            elif labels == SAFETY_MENU_WITHOUT_RETRY:
                expected_message = SAFETY_MESSAGE_WITHOUT_RETRY
            else:
                continue

            numbers = tuple(int(item.group("number")) for item in items)
            if numbers != tuple(range(1, len(items) + 1)):
                continue

            message = " ".join(
                line.strip()
                for line in lines[header_index + 1 : first_item_index]
                if line.strip()
            )
            if message != expected_message:
                continue

            footer_indices = [
                index
                for index, line in enumerate(lines[item_index:], start=item_index)
                if line.rstrip() == SAFETY_MENU_FOOTER
            ]
            if not footer_indices:
                continue
            footer_index = footer_indices[0]
            # The selection view owns the bottom of the current viewport. A
            # trailing non-empty line means this is likely quoted scrollback,
            # not an active menu, so never inject keys.
            if any(line.strip() for line in lines[footer_index + 1 :]):
                continue

            selected = [
                item.group("label")
                for item in items
                if item.group("cursor") == "›"
            ]
            if len(selected) == 1:
                return selection_names[selected[0]]

    return None


def appended_events(previous: list[str], current: list[str]) -> list[str]:
    """Find events appended to a rolling history window.

    The overlap calculation keeps working when tmux drops old scrollback lines.
    """

    maximum = min(len(previous), len(current))
    for overlap in range(maximum, -1, -1):
        if overlap == 0 or previous[-overlap:] == current[:overlap]:
            return current[overlap:]
    return current


def read_proc_stat(pid: int) -> tuple[int, int, str] | None:
    """Return (process group, foreground process group, start time)."""

    try:
        raw = Path(f"/proc/{pid}/stat").read_text()
        fields = raw[raw.rfind(")") + 2 :].split()
        return int(fields[2]), int(fields[5]), fields[19]
    except (IndexError, OSError, ValueError):
        return None


def process_children(pid: int) -> set[int]:
    """Return children created by any thread in a process."""

    children: set[int] = set()
    try:
        files = Path(f"/proc/{pid}/task").glob("*/children")
        for children_file in files:
            for child in children_file.read_text().split():
                children.add(int(child))
    except (OSError, ValueError):
        pass
    return children


def is_installed_codex_path(path: str) -> bool:
    """Accept current and npm-retained Codex native package paths."""

    deleted = path.endswith(" (deleted)")
    executable = Path(path.removesuffix(" (deleted)"))
    parts = executable.parts
    if executable.name != "codex" or not executable.is_absolute():
        return False

    for index in range(len(parts) - 5):
        if (
            parts[index : index + 3] == ("node_modules", "@openai", "codex")
            and parts[index + 3 : index + 5]
            == ("node_modules", "@openai")
            and parts[index + 5 :] in CODEX_NATIVE_PACKAGE_TAILS
        ):
            return True

    if not deleted:
        return False
    for index, component in enumerate(parts):
        retired = re.fullmatch(r"\.codex-([A-Za-z0-9]{8})", component)
        if (
            retired is None
            or index < 2
            or parts[index - 2 : index] != ("node_modules", "@openai")
        ):
            continue
        if (
            len(parts) <= index + 3
            or parts[index + 1 : index + 3] != ("node_modules", "@openai")
            or parts[index + 3 :] not in CODEX_NATIVE_PACKAGE_TAILS
        ):
            continue
        original = str(Path(*parts[:index]) / "codex")
        digest = base64.b64encode(
            hashlib.sha1(original.encode()).digest()
        ).decode()
        expected = re.sub(r"[^A-Za-z0-9]+", "", digest)[:8]
        if retired.group(1) == expected:
            return True
    return False


def installed_codex_executable(pid: int) -> Path | None:
    try:
        target = os.readlink(f"/proc/{pid}/exe")
    except (FileNotFoundError, PermissionError, ProcessLookupError):
        return None
    executable = Path(target.removesuffix(" (deleted)"))
    if is_installed_codex_path(target):
        return executable
    return None


def native_codex_in_process_group(
    root_pid: int, process_group: int
) -> tuple[int, str] | None:
    """Find the native Codex executable below the foreground group leader."""

    queue = [root_pid]
    visited: set[int] = set()

    while queue and len(visited) < 256:
        pid = queue.pop(0)
        if pid in visited:
            continue
        visited.add(pid)

        stat = read_proc_stat(pid)
        if (
            stat is not None
            and stat[0] == process_group
            and installed_codex_executable(pid) is not None
        ):
            return pid, stat[2]

        queue.extend(process_children(pid) - visited)

    return None


def codex_process_identity(pane_pid: int) -> str | None:
    """Identify Codex through the pane's actual foreground process group."""

    pane_stat = read_proc_stat(pane_pid)
    if pane_stat is None:
        return None

    foreground_pgid = pane_stat[1]
    if foreground_pgid <= 0:
        return None

    foreground_stat = read_proc_stat(foreground_pgid)
    if foreground_stat is None:
        return None

    native_codex = native_codex_in_process_group(
        foreground_pgid, foreground_pgid
    )
    if native_codex is None:
        return None

    # The foreground group may change while /proc is being traversed.
    final_pane_stat = read_proc_stat(pane_pid)
    if final_pane_stat is None or final_pane_stat[1] != foreground_pgid:
        return None

    native_pid, native_start_time = native_codex
    return (
        f"{foreground_pgid}:{foreground_stat[2]}:"
        f"{native_pid}:{native_start_time}"
    )


def list_panes(
    socket: str,
) -> list[tuple[str, int, str, bool, tuple[int, int]]] | None:
    result = run_tmux(
        socket,
        "list-panes",
        "-a",
        "-F",
        (
            "#{pane_id}|#{pane_pid}|#{pane_dead}|#{pane_in_mode}|"
            "#{pane_width}|#{pane_height}|#{session_name}"
        ),
    )
    if result.returncode != 0:
        return None

    panes: list[tuple[str, int, str, bool, tuple[int, int]]] = []
    for line in result.stdout.splitlines():
        parts = line.split("|", 6)
        if len(parts) != 7 or parts[2] == "1":
            continue
        try:
            pane_pid = int(parts[1])
            geometry = (int(parts[4]), int(parts[5]))
        except ValueError:
            continue
        panes.append(
            (parts[0], pane_pid, parts[6], tmux_mode_active(parts[3]), geometry)
        )
    return panes


def tmux_mode_active(value: str) -> bool:
    """Treat every nonzero mode depth, and malformed output, as active."""

    try:
        return int(value) != 0
    except ValueError:
        return True


def pane_is_in_mode(socket: str, pane: str) -> bool:
    result = run_tmux(
        socket,
        "display-message",
        "-p",
        "-t",
        pane,
        "#{pane_in_mode}",
    )
    return result.returncode != 0 or tmux_mode_active(result.stdout.strip())


def pane_cursor_x(socket: str, pane: str) -> int | None:
    result = run_tmux(
        socket,
        "display-message",
        "-p",
        "-t",
        pane,
        "#{cursor_x}|#{pane_in_mode}",
    )
    if result.returncode != 0:
        return None
    parts = result.stdout.strip().split("|", 1)
    if len(parts) != 2 or parts[1] != "0":
        return None
    try:
        return int(parts[0])
    except ValueError:
        return None


def pane_cursor_position(socket: str, pane: str) -> tuple[int, int] | None:
    """Return the live cursor cell only while the pane is outside a mode."""

    result = run_tmux(
        socket,
        "display-message",
        "-p",
        "-t",
        pane,
        "#{cursor_x}|#{cursor_y}|#{pane_in_mode}",
    )
    if result.returncode != 0:
        return None
    parts = result.stdout.strip().split("|", 2)
    if len(parts) != 3 or parts[2] != "0":
        return None
    try:
        return int(parts[0]), int(parts[1])
    except ValueError:
        return None


def composer_is_empty(cursor_x: int | None) -> bool:
    """Return whether tmux confirms the composer is still at its empty cell."""

    return cursor_x == EMPTY_COMPOSER_CURSOR_X


def styled_composer_is_empty(text: str, cursor_y: int) -> bool:
    """Accept only the cursor row's empty composer or dim placeholder."""

    lines = text.splitlines()
    if cursor_y < 0 or cursor_y >= len(lines):
        return False
    line = lines[cursor_y]
    cells: list[tuple[str, bool]] = []
    dim = False
    offset = 0
    for escape in ANSI_CSI_RE.finditer(line):
        cells.extend(
            (character, dim) for character in line[offset : escape.start()]
        )
        sequence = escape.group()
        if sequence.endswith("m"):
            parameters = sequence[2:-1].replace(":", ";").split(";")
            try:
                codes = [int(value) if value else 0 for value in parameters]
            except ValueError:
                codes = []
            for code in codes:
                if code in {0, 22}:
                    dim = False
                elif code == 2:
                    dim = True
        offset = escape.end()
    cells.extend((character, dim) for character in line[offset:])

    plain = "".join(character for character, _dim in cells)
    composer = EMPTY_COMPOSER_RE.fullmatch(plain)
    if composer is None:
        return False
    prompt_index = composer.start("prompt")
    content = [
        is_dim
        for character, is_dim in cells[prompt_index + 1 :]
        if not character.isspace()
    ]
    return not content or all(content)


def capture_event_text(socket: str, pane: str) -> str | None:
    result = run_tmux(
        socket,
        "capture-pane",
        "-p",
        "-J",
        "-S",
        f"-{CAPTURE_HISTORY_LINES}",
        "-t",
        pane,
    )
    if result.returncode != 0:
        return None
    return result.stdout


def capture_visible_text(socket: str, pane: str) -> str | None:
    result = run_tmux(socket, "capture-pane", "-p", "-J", "-t", pane)
    if result.returncode != 0:
        return None
    return result.stdout


def capture_visible_styled_text(socket: str, pane: str) -> str | None:
    # Do not use -J here: physical rows must stay aligned with #{cursor_y}.
    result = run_tmux(socket, "capture-pane", "-e", "-p", "-t", pane)
    if result.returncode != 0:
        return None
    return result.stdout


def current_terminal_events(
    socket: str, pane: str, events: list[str] | set[str]
) -> list[str] | None:
    text = capture_visible_text(socket, pane)
    if text is None:
        return None
    context_text = capture_event_text(socket, pane)
    if context_text is None:
        return None
    return [
        event
        for event in events
        if terminal_event_is_current_text(
            text,
            event,
            context_text=context_text,
        )
    ]


def goal_status_reply(status: str) -> str:
    if status in GOAL_RESUMABLE_STATUSES:
        return "/goal resume"
    return REPLY


def goal_footer_reply(status: str) -> str:
    if status.startswith(
        (
            "Pursuing goal",
            "Goal paused",
            "Goal stalled",
            "Goal hit usage limits",
        )
    ):
        return "/goal resume"
    return REPLY


def goal_resume_reply(text: str) -> str:
    """Choose the 429 command from the current event's strict Goal trailer.

    A current recoverable Goal uses ``/goal resume``. Every other 429 uses
    ``Continue`` because the error itself proves the ordinary turn stopped
    abnormally; terminal Goal labels only mean that Goal must not be resumed.
    """

    rate_limits = list(RATE_LIMIT_RE.finditer(text))
    if not rate_limits:
        return REPLY
    start = rate_limits[-1].end()
    statuses: list[tuple[int, str]] = []
    statuses.extend(
        (
            match.start(),
            goal_status_reply(match.group("status")),
        )
        for match in GOAL_STATUS_RE.finditer(text, start)
    )
    footer = goal_footer_status_match(text, start)
    if footer is not None:
        footer_status = footer.group("status")
        statuses.append(
            (
                footer.start(),
                goal_footer_reply(footer_status),
            )
        )
    if not statuses:
        return REPLY
    return sorted(statuses)[-1][1]


def capture_safety_menu_selection(socket: str, pane: str) -> str | None:
    """Inspect only the visible grid so stale scrollback cannot trigger keys."""

    text = capture_visible_text(socket, pane)
    if text is None:
        return None
    return safety_menu_selection(text)


def tmux_option_state(socket: str, option_name: str) -> bool | None:
    """Return an option's truth value, or None when tmux is unavailable."""

    result = run_tmux(socket, "show-options", "-gqv", option_name)
    if result.returncode != 0:
        return None
    value = result.stdout.strip().lower()
    return value in {"1", "on", "true", "yes"}


def tmux_option_enabled(socket: str, option_name: str) -> bool:
    return tmux_option_state(socket, option_name) is True


def option_enabled(socket: str) -> bool:
    return tmux_option_enabled(socket, OPTION_NAME)


def clear_pending(state: PaneState) -> None:
    state.pending_events.clear()
    state.pending_deferred_events.clear()
    state.pending_reply = None
    state.send_after = 0.0


def clear_compaction_wait(state: PaneState) -> None:
    state.awaiting_context_compacted = False
    state.context_compacted_seen = False
    state.context_retry_seen = False
    state.context_compaction_started = 0.0
    state.deferred_events.pop(CONTEXT_COMPACTED, None)


def observe_rate_limit_events(
    state: PaneState,
    events: list[str],
    now: float,
) -> float | None:
    """Record newly rendered 429s and return the fixed recovery delay."""

    latest_delay: float | None = None
    for event in events:
        if event == RATE_LIMIT:
            if (
                state.rate_limit_last_seen
                and now - state.rate_limit_last_seen
                > RATE_LIMIT_RETRY_RESET_SECONDS
            ):
                state.rate_limit_attempts = 0
            delay_index = min(
                state.rate_limit_attempts,
                len(RATE_LIMIT_RETRY_DELAYS_SECONDS) - 1,
            )
            latest_delay = RATE_LIMIT_RETRY_DELAYS_SECONDS[delay_index]
            state.rate_limit_attempts += 1
            state.rate_limit_last_seen = now
            state.rate_limit_retry_after = max(
                state.rate_limit_retry_after,
                now + latest_delay,
            )
        else:
            clear_rate_limit_backoff(state)
    return latest_delay


def clear_rate_limit_backoff(state: PaneState) -> None:
    state.rate_limit_attempts = 0
    state.rate_limit_last_seen = 0.0
    state.rate_limit_retry_after = 0.0


def reconcile_rate_limit_terminal(
    state: PaneState,
    new_events: list[str],
    current: bool,
) -> None:
    """Use a current-terminal transition when signature overlap is ambiguous."""

    if RATE_LIMIT in new_events:
        state.rate_limit_terminal_latched = True
        return
    if not current:
        state.rate_limit_terminal_latched = False
        return
    if not state.rate_limit_terminal_latched:
        new_events.append(RATE_LIMIT)
    state.rate_limit_terminal_latched = True


def reply_for_events(events: list[str]) -> str:
    if events and events[-1] == CONTEXT_TOO_LARGE:
        return COMPACT_COMMAND
    return REPLY


def schedule_pending(
    state: PaneState,
    events: list[str],
    now: float,
    *,
    deferred: bool,
    reply: str | None = None,
) -> None:
    state.pending_events = set(events)
    state.pending_deferred_events = set(events) if deferred else set()
    state.pending_reply = reply if reply is not None else reply_for_events(events)
    state.send_after = max(
        now + SETTLE_SECONDS,
        state.last_sent + MIN_SEND_GAP_SECONDS,
    )
    if RATE_LIMIT in events:
        state.send_after = max(state.send_after, state.rate_limit_retry_after)


def defer_events(
    state: PaneState,
    events: list[str],
    now: float,
    pane: str,
    session: str,
    reason: str,
) -> None:
    for event in events:
        if event in state.deferred_events:
            continue
        state.deferred_events[event] = now
        log(
            f"deferred {event} for pane {pane} ({session}); reason={reason}"
        )


def expire_deferred_events(
    state: PaneState, now: float, pane: str, session: str
) -> None:
    for event, seen_at in list(state.deferred_events.items()):
        expires_at = seen_at + DEFERRED_EVENT_TTL_SECONDS
        if now <= expires_at:
            continue
        del state.deferred_events[event]
        state.pending_events.discard(event)
        state.pending_deferred_events.discard(event)
        log(
            f"expired deferred {event} for pane {pane} ({session}) "
            f"after {DEFERRED_EVENT_TTL_SECONDS:.0f}s"
        )
    if not state.pending_events:
        clear_pending(state)


def expire_compaction_wait(
    state: PaneState, now: float, pane: str, session: str
) -> bool:
    if not state.awaiting_context_compacted:
        return False
    if now - state.context_compaction_started <= CONTEXT_COMPACTION_TTL_SECONDS:
        return False
    retry_context = state.context_retry_seen
    clear_pending(state)
    clear_compaction_wait(state)
    log(
        f"expired context-compaction wait for pane {pane} ({session}) "
        f"after {CONTEXT_COMPACTION_TTL_SECONDS:.0f}s"
    )
    return retry_context


def submit_text(
    socket: str,
    pane: str,
    pane_pid: int,
    process_identity: str,
    expected_events: set[str],
    reply: str,
) -> SubmitResult:
    """Paste text explicitly, then submit it with a real Enter key.

    Codex treats a rapid sequence of ordinary character key events as a paste
    burst. If Enter arrives during that burst, it inserts a newline instead of
    submitting. tmux bracketed paste reaches Codex as an explicit paste event,
    which clears that suppression state before the real Enter key is sent. The
    three tmux commands are queued together server-side to preserve ordering.
    """

    if not composer_is_empty(pane_cursor_x(socket, pane)):
        log(f"skipped pane {pane}: composer is not empty or not ready")
        return SubmitResult()

    buffer_name = f"codex-auto-continue-{os.getpid()}-{pane.lstrip('%')}"
    if codex_process_identity(pane_pid) != process_identity:
        log(f"skipped pane {pane}: Codex foreground process changed")
        return SubmitResult()
    if pane_is_in_mode(socket, pane) or not option_enabled(socket):
        log(f"skipped pane {pane}: pane mode or option changed")
        return SubmitResult()
    visible_text = capture_visible_text(socket, pane)
    if visible_text is None:
        log(f"skipped pane {pane}: pane viewport is unavailable")
        return SubmitResult(preserve_pending=True)
    if safety_menu_selection(visible_text) is not None:
        log(f"skipped pane {pane}: safety menu owns the keyboard")
        return SubmitResult()
    context_text = capture_event_text(socket, pane)
    if context_text is None:
        log(f"skipped pane {pane}: pane history is unavailable")
        return SubmitResult(preserve_pending=True)
    if not any(
        terminal_event_is_current_text(
            visible_text,
            event,
            context_text=context_text,
        )
        for event in expected_events
    ):
        log(f"skipped pane {pane}: terminal event is no longer current")
        return SubmitResult()

    if RATE_LIMIT in expected_events:
        reply = goal_resume_reply(visible_text)

    cursor_position = pane_cursor_position(socket, pane)
    if cursor_position is None or cursor_position[0] != EMPTY_COMPOSER_CURSOR_X:
        log(f"skipped pane {pane}: composer changed before styled capture")
        return SubmitResult()
    styled_text = capture_visible_styled_text(socket, pane)
    if styled_text is None:
        log(f"skipped pane {pane}: styled pane viewport is unavailable")
        return SubmitResult(preserve_pending=True)
    if not styled_composer_is_empty(styled_text, cursor_position[1]):
        log(f"skipped pane {pane}: composer contains user input")
        return SubmitResult()

    # A user can begin typing after the first composer check while the event
    # and Goal state are being revalidated. Check again immediately before
    # queuing paste plus Enter so their input is never overwritten or sent.
    if pane_cursor_position(socket, pane) != cursor_position:
        log(f"skipped pane {pane}: composer changed before submission")
        return SubmitResult()

    submitted = run_tmux(
        socket,
        "set-buffer",
        "-b",
        buffer_name,
        "--",
        reply,
        ";",
        "paste-buffer",
        "-p",
        "-d",
        "-b",
        buffer_name,
        "-t",
        pane,
        ";",
        "send-keys",
        "-t",
        pane,
        "Enter",
    )
    if submitted.returncode != 0:
        log(f"failed to submit reply to pane {pane}: {submitted.stderr.strip()}")
        return SubmitResult()
    return SubmitResult(reply=reply)


def choose_keep_waiting(
    socket: str,
    pane: str,
    pane_pid: int,
    process_identity: str,
) -> bool:
    """Move from Retry to Keep waiting, verify the row, then press Enter."""

    if codex_process_identity(pane_pid) != process_identity:
        log(f"skipped pane {pane}: Codex foreground process changed")
        return False
    if pane_is_in_mode(socket, pane) or not option_enabled(socket):
        log(f"skipped pane {pane}: pane mode or option changed")
        return False

    selection = capture_safety_menu_selection(socket, pane)
    if selection == "retry":
        moved = run_tmux(socket, "send-keys", "-t", pane, "Down")
        if moved.returncode != 0:
            log(f"failed to select Keep waiting in pane {pane}")
            return False

        deadline = time.monotonic() + MENU_REDRAW_TIMEOUT_SECONDS
        selection = None
        while time.monotonic() < deadline:
            time.sleep(MENU_REDRAW_POLL_SECONDS)
            if codex_process_identity(pane_pid) != process_identity:
                return False
            if pane_is_in_mode(socket, pane) or not option_enabled(socket):
                return False
            selection = capture_safety_menu_selection(socket, pane)
            if selection == "wait":
                break
            if selection == "learn":
                log(f"aborted pane {pane}: safety-menu selection moved past wait")
                return False

    if selection != "wait":
        return False

    # Recheck immediately before Enter so a concurrent key press cannot turn a
    # stale observation into accepting Retry or Learn more.
    if codex_process_identity(pane_pid) != process_identity:
        return False
    if pane_is_in_mode(socket, pane) or not option_enabled(socket):
        return False
    if capture_safety_menu_selection(socket, pane) != "wait":
        log(f"aborted pane {pane}: Keep waiting is no longer selected")
        return False

    accepted = run_tmux(socket, "send-keys", "-t", pane, "Enter")
    if accepted.returncode != 0:
        log(f"failed to accept Keep waiting in pane {pane}")
        return False
    return True


def lock_path(socket: str) -> Path:
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    digest = hashlib.sha256(socket.encode()).hexdigest()[:12]
    return Path(runtime_dir) / (
        f"tmux-codex-auto-continue-{os.getuid()}-{digest}.lock"
    )


def acquire_daemon_lock(socket: str) -> int | None:
    path = lock_path(socket)
    flags = os.O_RDWR | os.O_CREAT
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags, 0o600)
    try:
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(descriptor)
        return None

    os.ftruncate(descriptor, 0)
    os.write(descriptor, f"{os.getpid()}\n".encode())
    return descriptor


def daemon_pid(socket: str) -> int | None:
    try:
        pid = int(lock_path(socket).read_text().strip())
        os.kill(pid, 0)
        argv = [
            item.decode("utf-8", errors="replace")
            for item in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            if item
        ]
        if str(Path(__file__).resolve()) not in argv or socket not in argv:
            return None
        return pid
    except (OSError, ValueError):
        return None


def start_daemon(socket: str) -> bool:
    if daemon_pid(socket) is not None:
        return True
    script = str(Path(__file__).resolve())
    log_path = Path.home() / ".cache/tmux-codex-auto-continue.log"
    log_path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    resolved_tmux = tmux_command(socket).executable
    tmux_override = ""
    if Path(resolved_tmux).is_absolute():
        tmux_override = (
            "TMUX_CODEX_AUTO_CONTINUE_TMUX="
            f"{shlex.quote(resolved_tmux)} "
        )
    command = (
        f"umask 077; {tmux_override}{shlex.quote(sys.executable)} "
        f"{shlex.quote(script)} "
        f"--socket {shlex.quote(socket)} >> {shlex.quote(str(log_path))} 2>&1"
    )
    result = run_tmux(socket, "run-shell", "-b", command)
    return result.returncode == 0


def run_daemon(socket: str) -> int:
    lock_descriptor = acquire_daemon_lock(socket)
    if lock_descriptor is None:
        return 0

    # Keep the descriptor alive for the lifetime of the daemon.
    _ = lock_descriptor
    states: dict[str, PaneState] = {}
    initial_scan = True
    log(f"watching tmux server {socket}")

    while True:
        panes = list_panes(socket)
        if panes is None:
            log("tmux server is no longer available; exiting")
            return 0

        now = time.monotonic()
        enabled = option_enabled(socket)
        seen_panes: set[str] = set()

        for pane, pane_pid, session, in_mode, geometry in panes:
            seen_panes.add(pane)
            process_identity = codex_process_identity(pane_pid)
            if process_identity is None:
                states.pop(pane, None)
                continue

            context_text = capture_event_text(socket, pane)
            visible_text = capture_visible_text(socket, pane)
            if context_text is None or visible_text is None:
                states.pop(pane, None)
                continue
            events = event_signatures(context_text)
            rate_limit_current = (
                RATE_LIMIT in events
                and terminal_event_is_current_text(
                    visible_text,
                    RATE_LIMIT,
                    context_text=context_text,
                )
            )

            state = states.get(pane)
            if state is None or state.process_identity != process_identity:
                states[pane] = PaneState(
                    process_identity,
                    events,
                    geometry,
                    rate_limit_terminal_latched=rate_limit_current,
                )
                log(f"baselined Codex pane {pane} in session {session}")
                if initial_scan:
                    continue
                state = states[pane]
                new_events = [
                    event
                    for event in dict.fromkeys(events)
                    if terminal_event_is_current_text(
                        visible_text,
                        event,
                        context_text=context_text,
                    )
                ]
                if not new_events:
                    continue
            else:
                new_events = appended_events(state.events, events)

            if state.geometry != geometry:
                resized_events = new_events
                if (
                    state.awaiting_context_compacted
                    and CONTEXT_COMPACTED in resized_events
                ):
                    state.context_compacted_seen = True
                    state.context_compaction_started = now
                state.events = events
                state.geometry = geometry
                state.rate_limit_terminal_latched = rate_limit_current
                clear_pending(state)
                clear_rate_limit_backoff(state)
                state.deferred_events.clear()
                log(f"rebaselined resized Codex pane {pane} in session {session}")
                continue

            state.events = events
            reconcile_rate_limit_terminal(
                state,
                new_events,
                rate_limit_current,
            )
            rate_limit_delay = observe_rate_limit_events(state, new_events, now)
            if rate_limit_delay is not None:
                log(
                    f"delaying rate-limit recovery for pane {pane} "
                    f"({session}) by {rate_limit_delay:.0f}s"
                )

            menu_selection = safety_menu_selection(visible_text)
            if menu_selection is None:
                state.safety_menu_absent_polls += 1
                if state.safety_menu_absent_polls >= 2:
                    state.safety_menu_latched = False
            else:
                state.safety_menu_absent_polls = 0

            expire_deferred_events(state, now, pane, session)
            retry_expired_context = False
            if not (
                state.awaiting_context_compacted
                and CONTEXT_COMPACTED in new_events
            ):
                retry_expired_context = expire_compaction_wait(
                    state, now, pane, session
                )
            if retry_expired_context and CONTEXT_TOO_LARGE not in new_events:
                new_events.append(CONTEXT_TOO_LARGE)
            actionable_events = [
                event
                for event in new_events
                if event not in NON_ACTIONABLE_EVENTS
            ]

            # Disabling the watcher remains a hard boundary: do not replay
            # anything observed while it was off when it is enabled again.
            if not enabled:
                if menu_selection is not None:
                    state.safety_menu_latched = True
                clear_pending(state)
                clear_compaction_wait(state)
                clear_rate_limit_backoff(state)
                state.deferred_events.clear()
                continue

            # Copy mode and other tmux pane modes must never receive input.
            # Keep newly observed terminal events for a short, bounded window,
            # then revalidate them against the live viewport after mode exits.
            if in_mode:
                if state.awaiting_context_compacted:
                    if CONTEXT_COMPACTED in new_events:
                        state.context_compacted_seen = True
                        state.context_compaction_started = now
                        marker_index = (
                            len(new_events)
                            - 1
                            - new_events[::-1].index(CONTEXT_COMPACTED)
                        )
                        post_marker_events = [
                            event
                            for event in new_events[marker_index + 1 :]
                            if event not in NON_ACTIONABLE_EVENTS
                        ]
                        defer_events(
                            state,
                            [CONTEXT_COMPACTED, *post_marker_events],
                            now,
                            pane,
                            session,
                            "pane-mode",
                        )
                    elif state.context_compacted_seen:
                        defer_events(
                            state,
                            (
                                actionable_events
                                if new_events
                                else list(state.pending_events)
                            ),
                            now,
                            pane,
                            session,
                            "pane-mode",
                        )
                    else:
                        replacement_events = [
                            event
                            for event in actionable_events
                            if event != CONTEXT_TOO_LARGE
                        ]
                        if replacement_events:
                            clear_compaction_wait(state)
                            state.deferred_events.clear()
                            defer_events(
                                state,
                                replacement_events,
                                now,
                                pane,
                                session,
                                "pane-mode",
                            )
                        elif CONTEXT_TOO_LARGE in actionable_events:
                            state.context_retry_seen = True
                        elif new_events:
                            clear_compaction_wait(state)
                            state.deferred_events.clear()
                    clear_pending(state)
                else:
                    if new_events:
                        clear_pending(state)
                        state.deferred_events.clear()
                    defer_events(
                        state,
                        (
                            actionable_events
                            if new_events
                            else list(state.pending_events)
                        ),
                        now,
                        pane,
                        session,
                        "pane-mode",
                    )
                if menu_selection is not None:
                    state.safety_menu_latched = True
                    clear_compaction_wait(state)
                    clear_rate_limit_backoff(state)
                    state.deferred_events.clear()
                clear_pending(state)
                continue

            if menu_selection is not None:
                # A live selection view owns the keyboard; never fall through
                # to composer-oriented error recovery while it is visible.
                clear_pending(state)
                clear_compaction_wait(state)
                clear_rate_limit_backoff(state)
                state.deferred_events.clear()
                if (
                    menu_selection in {"retry", "wait"}
                    and not state.safety_menu_latched
                    and now
                    >= state.last_menu_attempt + MIN_MENU_ATTEMPT_GAP_SECONDS
                ):
                    state.last_menu_attempt = now
                    if choose_keep_waiting(
                        socket,
                        pane,
                        pane_pid,
                        process_identity,
                    ):
                        state.safety_menu_latched = True
                        state.last_sent = time.monotonic()
                        log(
                            f"accepted Keep waiting in pane {pane} "
                            f"({session})"
                        )
                continue

            if state.awaiting_context_compacted:
                if CONTEXT_COMPACTED in new_events:
                    state.context_compacted_seen = True
                    state.context_compaction_started = now
                    marker_index = len(new_events) - 1 - new_events[::-1].index(
                        CONTEXT_COMPACTED
                    )
                    post_marker_events = [
                        event
                        for event in new_events[marker_index + 1 :]
                        if event not in NON_ACTIONABLE_EVENTS
                    ]
                    clear_pending(state)
                    schedule_pending(
                        state,
                        [CONTEXT_COMPACTED, *post_marker_events],
                        now,
                        deferred=(
                            CONTEXT_COMPACTED in state.deferred_events
                        ),
                        reply=REPLY,
                    )
                elif state.context_compacted_seen:
                    if actionable_events:
                        clear_pending(state)
                        schedule_pending(
                            state,
                            actionable_events,
                            now,
                            deferred=False,
                            reply=REPLY,
                        )
                    elif not state.pending_events:
                        deferred_after_marker = [
                            event
                            for event in state.deferred_events
                            if event not in NON_ACTIONABLE_EVENTS
                        ]
                        schedule_pending(
                            state,
                            [CONTEXT_COMPACTED, *deferred_after_marker],
                            now,
                            deferred=(
                                CONTEXT_COMPACTED in state.deferred_events
                            ),
                            reply=REPLY,
                        )
                else:
                    replacement_events = [
                        event
                        for event in actionable_events
                        if event != CONTEXT_TOO_LARGE
                    ]
                    if replacement_events:
                        clear_pending(state)
                        clear_compaction_wait(state)
                        state.deferred_events.clear()
                        schedule_pending(
                            state,
                            replacement_events,
                            now,
                            deferred=False,
                        )
                    elif CONTEXT_TOO_LARGE in actionable_events:
                        state.context_retry_seen = True
                    elif new_events:
                        clear_pending(state)
                        clear_compaction_wait(state)
                        state.deferred_events.clear()
            elif new_events:
                # Every new terminal marker supersedes older pending state.
                # Normal and unknown Worked layouts are deliberately tracked
                # but never scheduled, so they also cancel a stale retry.
                clear_pending(state)
                state.deferred_events.clear()
                if actionable_events:
                    schedule_pending(
                        state,
                        actionable_events,
                        now,
                        deferred=False,
                    )
            elif not state.pending_events and state.deferred_events:
                deferred_candidates = [
                    event
                    for event in state.deferred_events
                    if event not in NON_ACTIONABLE_EVENTS
                ]
                for event in set(state.deferred_events) - set(
                    deferred_candidates
                ):
                    state.deferred_events.pop(event, None)
                current_events = current_terminal_events(
                    socket, pane, deferred_candidates
                )
                if current_events:
                    schedule_pending(
                        state,
                        current_events,
                        now,
                        deferred=True,
                    )

            if not state.pending_events or now < state.send_after:
                continue

            # Never inject keys into copy mode or another tmux pane mode.
            if in_mode or pane_is_in_mode(socket, pane):
                defer_events(
                    state,
                    list(state.pending_events),
                    now,
                    pane,
                    session,
                    "pane-mode-before-send",
                )
                clear_pending(state)
                continue

            # Recheck the process immediately before injecting input.
            if codex_process_identity(pane_pid) != process_identity:
                states.pop(pane, None)
                continue
            if not option_enabled(socket):
                clear_pending(state)
                clear_compaction_wait(state)
                clear_rate_limit_backoff(state)
                state.deferred_events.clear()
                continue
            current_events = current_terminal_events(
                socket,
                pane,
                state.pending_events,
            )
            if current_events is None:
                log(
                    f"preserved pending recovery for pane {pane} "
                    f"({session}); terminal capture is unavailable"
                )
                continue
            if not current_events:
                if (
                    state.awaiting_context_compacted
                    and state.context_compacted_seen
                ):
                    clear_compaction_wait(state)
                    state.deferred_events.clear()
                if RATE_LIMIT in state.pending_events:
                    clear_rate_limit_backoff(state)
                clear_pending(state)
                continue
            state.pending_events.intersection_update(current_events)
            state.pending_deferred_events.intersection_update(current_events)

            # A terminal event may be visible before Codex has rendered an
            # empty composer. Convert that one-shot miss into the same bounded,
            # revalidated recovery path used for copy mode.
            if pane_cursor_x(socket, pane) != EMPTY_COMPOSER_CURSOR_X:
                if (
                    state.awaiting_context_compacted
                    and state.context_compacted_seen
                ):
                    visible_text = capture_visible_text(socket, pane)
                    if visible_text is not None and composer_has_visible_input(
                        visible_text
                    ):
                        log(
                            f"canceled context-compaction continuation for "
                            f"pane {pane} ({session}); composer has user input"
                        )
                        clear_pending(state)
                        clear_compaction_wait(state)
                        state.deferred_events.clear()
                        continue
                    defer_events(
                        state,
                        list(state.pending_events),
                        now,
                        pane,
                        session,
                        "composer-not-ready",
                    )
                    clear_pending(state)
                    continue
                if not state.pending_deferred_events:
                    current_events = current_terminal_events(
                        socket,
                        pane,
                        state.pending_events,
                    )
                    defer_events(
                        state,
                        (
                            current_events
                            if current_events is not None
                            else list(state.pending_events)
                        ),
                        now,
                        pane,
                        session,
                        "composer-not-ready",
                    )
                clear_pending(state)
                continue

            kinds = ",".join(
                sorted(event.partition(":")[0] for event in state.pending_events)
            )
            reply = state.pending_reply or REPLY
            pending_deferred = set(state.pending_deferred_events)
            pending_events = set(state.pending_events)
            result = submit_text(
                socket,
                pane,
                pane_pid,
                process_identity,
                state.pending_events,
                reply,
            )
            if result.reply is not None:
                state.last_sent = time.monotonic()
                if result.reply == COMPACT_COMMAND:
                    clear_compaction_wait(state)
                    state.awaiting_context_compacted = True
                    state.context_compaction_started = state.last_sent
                    log(
                        f"sent /compact to pane {pane} ({session}); "
                        f"event={kinds}"
                    )
                else:
                    log(
                        f"sent {result.reply} to pane {pane} ({session}); "
                        f"event={kinds}"
                    )
                    if (
                        CONTEXT_COMPACTED in pending_events
                        or (
                            state.awaiting_context_compacted
                            and state.context_compacted_seen
                        )
                    ):
                        clear_compaction_wait(state)
                if pending_deferred:
                    state.deferred_events.clear()
            elif result.preserve_pending:
                continue
            clear_pending(state)

        for pane in set(states) - seen_panes:
            states.pop(pane, None)

        initial_scan = False
        time.sleep(POLL_INTERVAL_SECONDS)


def toggle(socket: str) -> int:
    new_value = "off" if option_enabled(socket) else "on"
    result = run_tmux(socket, "set-option", "-g", OPTION_NAME, new_value)
    if result.returncode != 0:
        print(result.stderr.strip(), file=sys.stderr)
        return 1
    if new_value == "on" and not start_daemon(socket):
        print("failed to start auto-continue watcher", file=sys.stderr)
        return 1
    run_tmux(
        socket,
        "display-message",
        f"Codex auto-continue: {new_value.upper()}",
    )
    return 0


def restart_daemon(socket: str) -> int:
    """Replace only this socket's verified watcher process."""

    enabled = tmux_option_state(socket, OPTION_NAME)
    if enabled is None:
        print("failed to query tmux auto-continue option", file=sys.stderr)
        return 1

    previous_pid = daemon_pid(socket)
    if previous_pid is not None:
        try:
            os.kill(previous_pid, signal.SIGTERM)
        except ProcessLookupError:
            previous_pid = None
        except PermissionError as error:
            print(f"failed to stop watcher {previous_pid}: {error}", file=sys.stderr)
            return 1

        deadline = time.monotonic() + DAEMON_RESTART_TIMEOUT_SECONDS
        while time.monotonic() < deadline:
            current_pid = daemon_pid(socket)
            if current_pid is None or current_pid != previous_pid:
                break
            time.sleep(0.05)
        else:
            print(
                f"watcher {previous_pid} did not stop after SIGTERM",
                file=sys.stderr,
            )
            return 1

    if not enabled:
        return 0
    if not start_daemon(socket):
        print("failed to restart auto-continue watcher", file=sys.stderr)
        return 1

    deadline = time.monotonic() + DAEMON_RESTART_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        current_pid = daemon_pid(socket)
        if current_pid is not None and current_pid != previous_pid:
            return 0
        time.sleep(0.05)
    print("replacement watcher did not start", file=sys.stderr)
    return 1


def show_status(socket: str) -> int:
    enabled = "on" if option_enabled(socket) else "off"
    pid = daemon_pid(socket)
    daemon = str(pid) if pid is not None else "not running"
    print(f"enabled={enabled} daemon={daemon} socket={socket}")

    panes = list_panes(socket)
    if panes is None:
        print("tmux server is unavailable", file=sys.stderr)
        return 1
    for pane, pane_pid, session, in_mode, _geometry in panes:
        if codex_process_identity(pane_pid) is not None:
            mode = "copy" if in_mode else "normal"
            print(f"codex-pane={pane} session={session} mode={mode}")
    return 0


def self_test() -> int:
    assert tmux_server_pid_from_environment(
        "/tmp/tmux-1000/default", "/tmp/tmux-1000/default,6252,38"
    ) == 6252
    assert tmux_server_pid_from_environment(
        "/tmp/tmux,socket", "/tmp/tmux,socket,6252,0"
    ) == 6252
    assert tmux_server_pid_from_environment(
        "/tmp/tmux-1000/other", "/tmp/tmux-1000/default,6252,38"
    ) is None
    assert tmux_server_pid_from_environment(
        "/tmp/tmux-1000/default", "/tmp/tmux-1000/default,invalid,38"
    ) is None
    assert tmux_server_pid_from_environment(
        "/tmp/tmux-1000/default", "/tmp/tmux-1000/default,0,38"
    ) is None
    assert is_installed_codex_path(
        "/home/user/.npm/lib/node_modules/@openai/codex/node_modules/"
        "@openai/codex-linux-arm64/vendor/aarch64-unknown-linux-musl/"
        "bin/codex"
    )
    assert is_installed_codex_path(
        "/home/user/.npm/lib/node_modules/@openai/codex/node_modules/"
        "@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex"
    )
    retired_parent = "/home/user/.npm/lib/node_modules/@openai/codex"
    retired_digest = base64.b64encode(
        hashlib.sha1(retired_parent.encode()).digest()
    ).decode()
    retired_suffix = re.sub(r"[^A-Za-z0-9]+", "", retired_digest)[:8]
    retired_path = (
        "/home/user/.npm/lib/node_modules/@openai/.codex-"
        f"{retired_suffix}/node_modules/@openai/codex-linux-arm64/"
        "vendor/aarch64-unknown-linux-musl/bin/codex"
    )
    assert is_installed_codex_path(f"{retired_path} (deleted)")
    assert not is_installed_codex_path(retired_path)
